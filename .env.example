# Required before exposing the service beyond a private network. Generate with:
# openssl rand -hex 32
COPTIC_API_KEY=

# Comma-separated exact browser origins. Empty disables browser cross-origin access.
COPTIC_ALLOWED_ORIGINS=

# Model IDs from the existing Coptic and Coptic-iOS Python translators.
COPTIC_C2E_MODEL=megalaa/coptic-english-translator
COPTIC_E2C_MODEL=megalaa/english-coptic-translator
COPTIC_C2E_REVISION=main
COPTIC_E2C_REVISION=main

# Persistent Hugging Face cache. In Docker this is backed by the hf-cache volume.
HF_HOME=/models
HF_TOKEN=

# Limits
COPTIC_MAX_INPUT_CHARS=1200
COPTIC_RATE_LIMIT=30/minute
COPTIC_CACHE_ENTRIES=1000
COPTIC_CACHE_TTL_SECONDS=3600
